{
  "name": "pulsar-ide-laevi",
  "version": "0.1.1",
  "description": "Language server support for Bash, YAML, TypeScript/JavaScript, Python, CSS, and JSON, including standalone files outside a project folder.",
  "main": "./lib/main.js",
  "repository": "https://github.com/ViolinKaine/pulsar-ide-laevi",
  "license": "MIT",
  "engines": {
    "atom": ">=1.21.0 <2.0.0"
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "consumedServices": {
    "linter-indie": {
      "versions": {
        "2.0.0": "consumeLinterV2"
      }
    },
    "status-bar": {
      "versions": {
        "1.1.0": "consumeStatusBar"
      }
    }
  },
  "providedServices": {
    "linter": {
      "versions": {
        "2.0.0": "provideLinter"
      }
    },
    "outline-view": {
      "versions": {
        "0.1.0": "provideOutlines"
      }
    }
  },
  "dependencies": {
    "@biomejs/biome": "^1.9.0",
    "@savetheclocktower/atom-languageclient": "^1.17.11",
    "postcss": "^8.4.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.0"
  }
}
