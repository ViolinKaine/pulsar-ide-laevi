{
  "name": "pulsar-ide-laevi",
  "version": "0.1.0",
  "description": "Direct LSP wiring for Bash, YAML, and TypeScript/JavaScript, plus synchronous linting for JSON and CSS, including standalone files outside a project folder.",
  "main": "./lib/main.js",
  "engines": {
    "atom": ">=1.21.0 <2.0.0"
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "consumedServices": {
    "linter-indie": {
      "versions": {
        "2.0.0": "consumeLinterV2"
      }
    },
    "status-bar": {
      "versions": {
        "1.1.0": "consumeStatusBar"
      }
    }
  },
  "providedServices": {
    "linter": {
      "versions": {
        "2.0.0": "provideLinter"
      }
    }
  },
  "dependencies": {
    "@savetheclocktower/atom-languageclient": "^1.17.11",
    "postcss": "^8.4.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.0"
  }
}
